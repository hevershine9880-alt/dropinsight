# ---------------------------------------------------------------------------
# DropInsight environment
# Copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

# Database. SQLite for local development; swap the provider in prisma/schema.prisma
# to "postgresql" and point this at a Postgres URL for production.
DATABASE_URL="file:./dev.db"

# Public origin of the app. Used to build eBay OAuth redirect URLs.
APP_URL="http://localhost:3000"

# Name of the session cookie.
SESSION_COOKIE_NAME="dropinsight_session"

# AES-256-GCM key for encrypting eBay OAuth tokens at rest.
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# eBay integration
# ---------------------------------------------------------------------------
# "mock" runs the full integration code path against a deterministic local
# adapter — no eBay credentials needed. "live" calls the real eBay APIs.
EBAY_ADAPTER="mock"

# "sandbox" or "production"
EBAY_ENV="sandbox"

# From https://developer.ebay.com → your application keyset.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# The RuName / redirect URI registered against the keyset above.
EBAY_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Stripe, for real billing. Without these the app uses its internal plan state.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shared secret required by POST /api/jobs/tick when driving the worker from cron.
JOB_RUNNER_TOKEN=""
